{
  "name": "bgavalda/cuina-de-profit",
  "description": "Cuina de profit",
  "license": "proprietary",
  "authors": [
    {
      "name": "Barbara Gavalda",
      "email": "barbaragavalda@gmail.com"
    }
  ],
  "repositories": [
    {
      "type": "vcs",
      "url": "git@bitbucket.org:appaqui/freimguork-core.git"
    },
    {
      "type": "vcs",
      "url": "git@bitbucket.org:appaqui/freimguork-appacman.git"
    }
  ],
  "require": {
    "php": "^8.5",
    "appaqui/freimguork-core": "dev-master",
    "appaqui/freimguork-appacman": "dev-master",
    "ext-gettext": "*",
    "ext-intl": "*",
    "ext-libxml": "*",
    "ext-pdo": "*",
    "ext-simplexml": "*"
  },
  "autoload": {
    "psr-4": {
      "": "src/"
    }
  },
  "minimum-stability": "dev",
  "config": {
    "allow-plugins": {
      "composer/installers": true
    }
  }
}
