{% extends 'basic.twig' %}

{% block extraHead %}
    <link rel="stylesheet" href="{{ staticDomain }}js/plugin/OverlayScrollbars/css/OverlayScrollbars.min.css"
          type="text/css">
{% endblock %}
{% block extraBody %}
    <script src="{{ staticDomain }}js/plugin/OverlayScrollbars/js/jquery.overlayScrollbars.min.js"></script>
    <script src="{{ staticDomain }}js/search{{ min }}.js?v={{ staticVersion }}"></script>
    <script>
        $(document).ready(function () {
            $('.filter ul').each(function () {
                OverlayScrollbars($(this), {
                    className: 'os-theme-dark'
                });
            });

            new Search('{{ domain ~ link }}/');
        });
    </script>
{% endblock %}

{% block content %}
    <div id="list" class="{{ menu }} container-fluid">
        {% block header %}{% endblock %}
        <div class="row">
            {% if not hideFilters %}
                {% include 'include/list-filters.twig' %}
            {% endif %}
            <div class="col-lg-10">
                {% if filters.query %}
                    <div class="title">{% trans "Resultats per" %} <h1>"{{ filters.query|lower }}"</h1>
                    </div>
                {% endif %}
                {% block filteredView %}{% endblock %}
            </div>
        </div>
    </div>
{% endblock %}