<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
    {% if not isDev %}
        <!-- Google tag (gtag.js) -->
        <script async src="https://www.googletagmanager.com/gtag/js?id=G-SZG8BKL1PN"></script>
        <script>
            window.dataLayer = window.dataLayer || [];

            function gtag() {
                dataLayer.push(arguments);
            }

            gtag('js', new Date());

            gtag('config', 'G-SZG8BKL1PN');
        </script>
    {% endif %}
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <link rel="shortcut icon" href="{{ staticDomain }}img/favicon.ico" type="image/x-icon">

    <title>{{ metatagTitle }}</title>
    <meta name="keywords" content="{{ metatagKeywords }}">
    <meta name="description" content="{{ metatagDescription|striptags }}">

    <meta property="og:locale" content="es_ES">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="{{ webName }}">
    <meta property="og:url" content="{{ canonical }}">
    <meta property="og:title" content="{{ metatagTitle }}">
    <meta property="og:description" content="{{ metatagDescription|striptags }}">
    <meta property="og:image" content="{{ metatagImage['image'] }}">
    <meta property="og:image:width" content="{{ metatagImage['width'] }}">
    <meta property="og:image:height" content="{{ metatagImage['height'] }}">

    <link rel="stylesheet" href="{{ staticDomain }}css/bootstrap.min.css" type="text/css">
    <link rel="stylesheet" href="{{ staticDomain }}css/font-awesome.min.css" type="text/css">
    <link rel="stylesheet" href="{{ staticDomain }}css/style{{ min }}.css?v={{ staticVersion }}" type="text/css">

    {% block extraHead %}{% endblock %}
</head>
<body>
<header id="main-header">
    <div class="container-xl">
        <div class="logo">
            {% block startLogo %}<a href="{{ domain }}">{% endblock %}
                <img src="{{ staticDomain }}img/logo-black.png" alt="{{ webName }}">
                {% block endLogo %}</a>{% endblock %}
        </div>
        <ul id="languages">
            {% set langs = [{name: 'Català', uri: 'ca'}, {name: 'Castellano', uri: 'es'}] %}
            {% for item in langs %}
                {% set class = '' %}
                {% if item.uri == lang %}
                    {% set class = ' class="current"' %}
                {% endif %}
                <li><a href="{{ rootDomain }}{{ item.uri }}/{{ translations[item.uri] }}" {{ class|raw }}
                       title="{{ item.name }}">{{ item.uri }}</a>
                </li>
            {% endfor %}
        </ul>
        <div class="menu">
            <nav class="mobile-menu">
                <ul>
                    {% include 'include/li-menu.twig' with{ name: 'Inici', link: '', code: '' } %}
                    {% include 'include/li-menu.twig' with{ name: 'Receptes', link: 'receptes', code: 'recipes' } %}
                    {% include 'include/li-menu.twig' with{ name: 'Restaurants', link: 'restaurants', code: 'restaurants' } %}
                </ul>
            </nav>
            <div class="search-button secondary-color">
                <i class="fa fa-search"></i>
            </div>
        </div>
        <div id="mobile-menu-wrap"></div>
    </div>
</header>

{% block content %}{% endblock %}

<footer class="main-bg">
    <div class="container-xl">
        <div class="row">
            <div class="col-md-5">
                <div class="logo">
                    <a href="{{ domain }}">
                        <img src="{{ staticDomain }}img/logo-white.png" alt="{{ webName }}">
                    </a>
                </div>
                <p>{% trans "En aquesta web trobareu algunes de les nostres receptes preferides que sabem que us encanten, però també receptes fàcils per poder fer en el dia a dia." %}</p>
            </div>
        </div>
        <div class="row">
            <div class="col-lg-12">
                <div class="copy secondary-color">
                    Copyright &copy;2021-
                    <script>document.write(new Date().getFullYear());</script> {{ webName }}
                </div>
            </div>
        </div>
    </div>
    {% include 'include/cookies.twig' %}
</footer>
<div id="search-model" class="main-bg">
    <div class="h-100 d-flex align-items-center justify-content-center">
        <div class="close tertiary-bg">+</div>
        <form action="{{ domain }}{% trans "receptes" %}" method="GET">
            <input type="text" name="q" class="secondary-border white-color"
                   placeholder="{% trans "Buscar..." %}">
        </form>
    </div>
</div>

<script src="{{ staticDomain }}js/plugin/jquery-3.3.1.min.js"></script>
<script src="{{ staticDomain }}js/plugin/bootstrap.min.js"></script>
<script src="{{ staticDomain }}js/lang{{ min }}.js?v={{ staticVersion }}"></script>
<script src="{{ staticDomain }}js/main{{ min }}.js?v={{ staticVersion }}"></script>
<script>
    var LANG = new Language('{{ lang }}');
</script>
{% block extraBody %}{% endblock %}
</body>
</html>