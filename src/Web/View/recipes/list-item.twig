<div class="col-sm-8">
    {% if item.tags|length > 0 %}
        <div>
            {% set tags = [] %}
            {% for tag in item.tags %}
                {% set tags = tags|merge(['<a href="' ~ domain ~ 'receptes'|trans ~ '/' ~ tag.uri ~ '" class="main-color">' ~ tag.name ~ '</a>']) %}
            {% endfor %}
            {{ tags|join(' | ')|raw }}
        </div>
    {% endif %}
    <h2>
        <a href="{{ domain }}{% trans "recepta" %}/{{ item.uri }}" class="secondary-font">
            {{ item.name }}
        </a>
        {% if item.is_exclusive %}
            <small class="badge badge tertiary-bg">{% trans "exclusiu" %}</small>
        {% else %}
            {% if not item.is_visible %}
                <small class="badge badge secondary-bg black-color">{% trans "esborrany" %}</small>
            {% endif %}
        {% endif %}
    </h2>
    <div>
        {% include 'recipes/difficulty.twig' with { recipe: item } %}
        <small>
            {{ item.time }}
            {% if item.rest_time %}
                (+ {{ item.rest_time }} {% trans "repòs" %})
            {% endif %}
        </small>
    </div>
    {% if item.description %}
        {{ item.description|raw }}
    {% endif %}
</div>