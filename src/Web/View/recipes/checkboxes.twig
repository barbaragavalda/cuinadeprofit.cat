{% if checkboxes|length > 0 %}
    <div class="filter">
        <h6>{{ title }}</h6>
        {% if checkboxes|length > 10 %}
            <div class="input-group input-group-sm mb-1">
                <div class="input-group-prepend">
                    <span class="input-group-text"><i class="fa fa-search"></i></span>
                </div>
                <input type="text" class="form-control search"/>
                <div class="input-group-append">
                    <span class="input-group-text"><i class="fa fa-close"></i></span>
                </div>
            </div>
        {% endif %}
        {% set selected = [] %}
        {% set normal = [] %}
        {% for checkbox in checkboxes %}
            {% set li %}
                <li class="custom-control custom-{{ type }}">
                    {% set checked = '' %}
                    {% if field == 'time' or field == 'rate' %} 
                        {% if filters[field][0] != "" and filters[field][0] == checkbox.id[0] %}
                            {% set checked = 'checked' %}
                        {% endif %}
                    {% else %}
                        {% if checkbox.id in filters[field] %}
                            {% set checked = 'checked' %}
                        {% endif %}
                    {% endif %}
                    {% set multiple = '' %}
                    {% if type == 'checkbox' %}
                        {% set multiple = '[]' %}
                    {% endif %}
                    <input type="{{ type }}" class="custom-control-input" name="{{ field }}{{ multiple }}"
                           id="{{ field }}-{{ checkbox.uri }}" value="{{ checkbox.uri }}" {{ checked }} />
                    <label class="custom-control-label"
                           for="{{ field }}-{{ checkbox.uri }}"><small>{{ checkbox.name }}</small></label>
                </li>
            {% endset %}

            {% if checkboxes|length > 10 and filters[field] == checkbox.uri %}
                {% set selected = selected|merge([li]) %}
            {% else %}
                {% set normal = normal|merge([li]) %}
            {% endif %}
        {% endfor %}
        <ul>
            {{ selected|join|raw }}
            {{ normal|join|raw }}
        </ul>
    </div>
{% endif %}