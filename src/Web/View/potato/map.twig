{% extends 'basic.twig' %}

{% block content %}
    <section class="wrapper container-fluid">
        {% if stats|length > 0 %}
            <div class="stats">
                {% set color = 'secondary-bg' %}
                {% for stat in stats %}
                    <style>
                        #stat-{{ loop.index }} .mask.full,
                        #stat-{{ loop.index }} .fill {
                            animation: fill{{ loop.index }} ease-in-out 2s;
                            transform: rotate({{ stat.degrees }}deg);
                        }

                        @keyframes fill{{ loop.index }} {
                            0% {
                                transform: rotate(0deg);
                            }
                            100% {
                                transform: rotate({{ stat.degrees }}deg);
                            }
                        }
                    </style>
                    <div>
                        <div id="stat-{{ loop.index }}" class="stat grey-bg">
                            <div class="mask full">
                                <div class="fill {{ color }}"></div>
                            </div>
                            <div class="mask half">
                                <div class="fill {{ color }}"></div>
                            </div>
                            <p class="black-color white-bg">{{ stat.value }}</p>
                        </div>
                        {{ stat.name }}
                    </div>
                    {% set color = 'main-bg' %}
                    {% if loop.index == (stats|length - 1) %}
                        {% set color = 'tertiary-bg' %}
                    {% endif %}
                {% endfor %}
            </div>
        {% endif %}
        <div style="text-align: center; padding: 50px 0">
            <h1 class="secondary-color">{{ 'Pròximament' }}</h1>
            {% set link = 'patates-braves' %}
            {% if lang == 'es' %}
                {% set link = 'patatas-bravas' %}
            {% endif %}
            <a href="{{ domain ~ 'recepta'|trans }}/{{ link }}" class="main-color"><u>{{ 'Mentrestant: la nostra recepta' }}</u></a>
        </div>
    </section>
{% endblock %}