{% set finalUnit = '' %}
{% if ingredient.amount == 0 %}
    {% set finalUnit = ' ' ~ ingredient.unit  %}
{% else %}
    <span class="ingredient-{{ ingredient.uri }}" data-unit="{{ ingredient.unit }}" data-plural="{{ ingredient.unitPlural }}">
        {{ ingredient.amount }}
        {% if ingredient.amount != 1 and ingredient.unitPlural != '' %}
            {{ ingredient.unitPlural }}
        {% else %}
            {{ ingredient.unit }}
        {% endif %}
    </span>
{% endif %}
<a href="{{ domain }}{% trans %}recetas{% endtrans %}/{{ ingredient.uri }}" class="main-color">{{ ingredient.name|lower }}</a>{{ finalUnit }}
{% if ingredient.recipes|length > 0 %}
    {% set links = [] %}
    {% for recipe in ingredient.recipes %}
        {% set name = 'ver receta'|trans %}
        {% if recipe.time %}
            {% if recipe.rest_time %}
                {% set name = 'ver receta + %s y %s de reposo'|trans|format(recipe.time, recipe.rest_time) %}
            {% else %}
                {% set name = 'ver receta + %s'|trans|format(recipe.time) %}
            {% endif %}
        {% endif %}
        {% set links = links|merge(['<a href="' ~ domain ~ 'receta'|trans ~ '/' ~ recipe.uri ~ '" class="black-color" target="_blank">' ~ name ~ '</a>']) %}
    {% endfor %}
    <small>({{ links|join(' | ')|raw }})</small>
{% endif %}
{% if ingredient.is_optional %}({% trans %}opcional{% endtrans %}){% endif %}