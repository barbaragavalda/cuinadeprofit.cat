{% set finalUnit = '' %}
{% if ingredient.amount == 0 %}
    {% set finalUnit = ' ' ~ ingredient.unit  %}
{% else %}
    <span class="{{ ingredient.uri }}" data-unit="{{ ingredient.unit }}" data-plural="{{ ingredient.unitPlural }}">
        {{ ingredient.amount }}
        {% if ingredient.amount != 1 and ingredient.unitPlural != '' %}
            {{ ingredient.unitPlural }}
        {% else %}
            {{ ingredient.unit }}
        {% endif %}
    </span>
{% endif %}
<a href="{{ domain }}{% trans %}ingrediente{% endtrans %}/{{ ingredient.uri }}" class="main-color">{{ ingredient.name|lower }}</a>{{ finalUnit }}
{% if ingredient.recipe %}
    <small>(<a href="{{ domain }}{% trans %}receta{% endtrans %}/{{ ingredient.recipe }}" class="black-color" target="_blank">{% trans %}ver receta{% endtrans %}</a>)</small>
{% endif %}