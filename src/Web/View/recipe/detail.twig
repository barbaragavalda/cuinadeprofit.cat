{% extends 'basic.twig' %}

{% block extraHead %}
    <link rel="stylesheet" href="{{ staticDomain }}js/plugin/slick-1.8.1/slick/slick.css" type="text/css">
{% endblock %}
{% block extraBody %}
    <script src="{{ staticDomain }}js/plugin/slick-1.8.1/slick/slick.min.js"></script>
    <script src="{{ staticDomain }}js/recipe{{ min }}.js?v={{ staticVersion }}"></script>
    <script>
        $(document).ready(function () {
            {% set currentAmount = 1 %}
            {% for spec in recipe.specs %}
            {% if spec.type in ['amount', 'diners'] %}
            {% set currentAmount = spec.value %}
            {% endif %}
            {% endfor %}

            var totalSteps = {{ recipe.steps|length }},
                ingredients = {{ recipe.ingredients|json_encode|raw }};
            new Recipe(totalSteps, ingredients, {{ currentAmount }});
        });
    </script>
{% endblock %}

{% block content %}
    <section id="recipe-detail" class="wrapper container-fluid">
        <div class="row">
            <aside class="col-md-4">
                <div class="ingredients">
                    <header>
                        {% if recipe.image %}
                            {% include 'include/image.twig' with { url: recipe.image, aspectRatio: '1/1' } %}
                        {% endif %}
                        <div class="resume grey-bg">
                            <h1 class="ms-madi secondary-color">{{ recipe.name }}</h1>
                            {% include 'recipe/difficulty.twig' %}
                            {% for tag in recipe.tags %}
                                <a href="{{ domain }}{% trans %}recetas{% endtrans %}/{{ tag.uri }}"
                                   class="badge badge-light main-color">{{ tag.name }}</a>
                            {% endfor %}
                        </div>
                        {% if recipe.specs|length > 0 %}
                            <ul class="main-bg">
                                {% for spec in recipe.specs %}
                                    {% if spec.type in ['amount', 'diners'] %}
                                        <li class="multiplier">
                                            <label for="amount" class="pt-2">{{ spec.name }}:</label>
                                            <div class="input-group pt-1 ml-1">
                                                <div class="input-group-prepend">
                                                    <button id="subtract" class="btn secondary-bg" type="button">-
                                                    </button>
                                                </div>
                                                <input id="amount" class="{{ spec.type }} form-control" type="text"
                                                       value="{{ spec.value }}"/>
                                                <div class="input-group-append">
                                                    <button id="add" class="btn secondary-bg" type="button">+</button>
                                                </div>
                                            </div>
                                        </li>
                                    {% else %}
                                        <li>{{ spec.name }}: <span>{{ spec.value }}</span></li>
                                    {% endif %}
                                {% endfor %}
                            </ul>
                        {% endif %}
                    </header>
                    <div class="list grey-border">
                        <h5>{% trans %}Ingredientes{% endtrans %}</h5>
                        <ul>
                            {% set i = 0 %}
                            {% for ingredient in recipe.ingredients %}
                                {% if i < recipe.ingredients|length %}
                                    <li>
                                        {% include 'recipe/ingredient.twig' with{ ingredient: recipe.ingredients[i] } %}
                                        {% if recipe.ingredients[i+1].is_alternative %}
                                            {% set i = i + 1 %}
                                            {% trans %}o{% endtrans %} {% include 'recipe/ingredient.twig' with{ ingredient: recipe.ingredients[i] } %}
                                        {% endif %}
                                        {% set i = i + 1 %}
                                    </li>
                                {% endif %}
                            {% endfor %}
                        </ul>
                    </div>
                    {% if recipe.link %}
                        <div class="link tertiary-bg">
                            <a href="{{ recipe.link }}" target="_blank"
                               class="black-color">{% trans %}Receta original{% endtrans %}</a>
                        </div>
                    {% endif %}
                </div>
            </aside>
            <div class="col-md-8">
                {% if recipe.steps|length > 0 %}
                    {% if recipe.steps|length > 1 %}
                        <h3></h3>
                        <div class="progress">
                            <div class="progress-bar secondary-bg" role="progressbar" style="width: 0%"></div>
                        </div>
                        <div id="arrows" class="clearfix">
                            <button type="button"
                                    class="previous btn secondary-bg white-color fa fa-angle-left"></button>
                            <button type="button" class="next btn secondary-bg white-color fa fa-angle-right"></button>
                        </div>
                    {% endif %}
                    <div class="steps">
                        {% for step in recipe.steps %}
                            <div>
                                {% set currentStep = 'Paso %s'|trans|format(loop.index) %}
                                {% if recipe.steps|length > 1 %}
                                    <span class="main-color">{{ currentStep }}</span>
                                {% endif %}
                                {{ step.description|raw }}
                                {% if step.image %}
                                    <div>
                                        <img src="{{ step.image }}" name="{{ recipe.name }} - {{ currentStep }}"/>
                                    </div>
                                {% endif %}
                                {% if step.video %}
                                    <div>
                                        <video controls>
                                            <source src="{{ step.video }}" type="video/mp4">
                                        </video>
                                    </div>
                                {% endif %}
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        </div>
    </section>
{% endblock %}