{% extends 'basic.twig' %}

{% block extraHead %}
    <link rel="stylesheet" href="{{ staticDomain }}js/plugin/slick-1.8.1/slick/slick.css" type="text/css">
{% endblock %}
{% block extraBody %}
    <script src="{{ staticDomain }}js/plugin/slick-1.8.1/slick/slick.min.js"></script>
    <script src="{{ staticDomain }}js/recipe.js"></script>
    <script>
        $(document).ready(function() {
            {% set currentAmount = 1 %}
            {% for spec in recipe.specs %}
                {% if spec.type in ['amount', 'diners'] %}
                    {% set currentAmount = spec.value %}
                {% endif %}
            {% endfor %}

            var totalSteps = {{ recipe.steps|length }},
                ingredients = {{ recipe.ingredients|json_encode|raw }};
            new Recipe(totalSteps, ingredients, {{ currentAmount }});
        });
    </script>
{% endblock %}

{% block content %}
    <section id="recipe-detail" class="container-xl">
        <div class="row">
            <aside class="col-lg-5">
                <div class="ingredients">
                    <header>
                        {% if recipe.image %}
                            <div class="img" style="background-image: url('{{ recipe.image }}')"></div>
                        {% endif %}
                        <div  class="main-bg">
                            <h1>{{ recipe.name }}</h1>
                            {% for tag in recipe.tags %}
                                <a href="{{ domain }}{% trans %}tag{% endtrans %}/{{ tag.uri }}" class="badge badge-light main-color">{{ tag.name }}</a>
                            {% endfor %}
                        </div>
                        {% if recipe.specs|length > 0 %}
                            <ul class="black-bg">
                                {% for spec in recipe.specs %}
                                    <li>
                                        {% if spec.type in ['amount', 'diners'] %}
                                            <label for="amount" class="pt-2 float-left">{{ spec.name }}:</label>
                                            <div class="input-group pt-1 ml-1 float-left">
                                                <div class="input-group-prepend">
                                                    <button id="subtract" class="btn secondary-bg" type="button">-</button>
                                                </div>
                                                <input id="amount" class="{{ spec.type }} form-control" type="text" value="{{ spec.value }}" />
                                                <div class="input-group-append">
                                                    <button id="add" class="btn secondary-bg" type="button">+</button>
                                                </div>
                                            </div>
                                        {% else %}
                                            {{ spec.name }}: <span>{{ spec.value }}</span>
                                        {% endif %}
                                    </li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                    </header>
                    <div class=" grey-border">
                        <h5>{% trans %}Ingredientes{% endtrans %}</h5>
                        <ul>
                            {% set i = 0 %}
                            {% for ingredient in recipe.ingredients %}
                                {% if i < recipe.ingredients|length %}
                                    <li>
                                        {% include 'recipe/ingredient.twig' with{ ingredient: recipe.ingredients[i] } %}
                                        {% if recipe.ingredients[i+1].is_alternative %}
                                            {% set i = i + 1 %}
                                            ({% trans %}o{% endtrans %} {% include 'recipe/ingredient.twig' with{ ingredient: recipe.ingredients[i] } %})
                                        {% endif %}
                                        {% set i = i + 1 %}
                                    </li>
                                {% endif %}
                            {% endfor %}
                        </ul>
                    </div>
                </div>
            </aside>
            <div class="col-lg-7">
                {% if recipe.steps|length > 0 %}
                    <h3></h3>
                    <div class="progress">
                        <div class="progress-bar secondary-bg" role="progressbar" style="width: 0%"></div>
                    </div>
                    <div id="arrows" class="clearfix">
                        <button type="button" class="previous btn main-bg white-color fa fa-angle-left"></button>
                        <button type="button" class="next btn main-bg white-color fa fa-angle-right"></button>
                    </div>
                    <div class="steps">
                        {% for step in recipe.steps %}
                            <div>
                                <span class="main-color">{{ 'Paso %s'|trans|format(index.lopp) }}</span>
                                <p>{{ step.description|raw }}</p>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        </div>
    </section>
{% endblock %}