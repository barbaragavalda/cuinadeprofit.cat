{% extends 'basic.twig' %}

{% block extraHead %}
    <link rel="stylesheet" href="{{ staticDomain }}js/plugin/slick-1.8.1/slick/slick.css" type="text/css">
{% endblock %}
{% block extraBody %}
    <script src="{{ staticDomain }}js/plugin/slick-1.8.1/slick/slick.min.js"></script>
    <script>
        $(document).ready(function() {
            var _totalSteps = 5,
                _progressBar = $('.progress-bar'),
                _steps = $('#recipe-detail h3');

            $('.steps')
                .on('init', function(){
                    updateStates(1);
                })
                .slick({
                    adaptiveHeight: true,
                    arrows: false,
                    infinite: false,
                    pauseOnFocus: false
                })
                .on('afterChange', function(event, slick, currentSlide){
                    updateStates(currentSlide+1);
                });

            function updateStates(step){
                var steps = LANG.localize('step_x_of_total');
                steps = steps.replace('%x', step);
                steps = steps.replace('%t', _totalSteps);
                _steps.html(steps);
                _progressBar.css('width', ((100/(_totalSteps-1))*(step-1)) + '%');
            }
        });
    </script>
{% endblock %}

