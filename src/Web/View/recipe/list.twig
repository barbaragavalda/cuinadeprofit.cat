{% extends 'basic.twig' %}

{% block extraHead %}
    <link rel="stylesheet" href="{{ staticDomain }}js/plugin/OverlayScrollbars/css/OverlayScrollbars.min.css" type="text/css">
{% endblock %}
{% block extraBody %}
    <script src="{{ staticDomain }}js/plugin/OverlayScrollbars/js/jquery.overlayScrollbars.min.js"></script>
    <script src="{{ staticDomain }}js/recipes.js?v={{ staticVersion }}"></script>
    <script>
        $(document).ready(function() {
            $('.filter ul').each(function(){
                OverlayScrollbars($(this), {
                    className       : 'os-theme-dark'
                });
            });

            new Recipes('{{ domain ~ 'recetas'|trans }}/');
        });
    </script>
{% endblock %}

{% block content %}
    <div id="list" class="container-fluid">
        <div class="row">
            <form method="POST" class="col">
                {% set buttons %}
                    <div class="btn-group-sm">
                        <button type="submit" name="filter" class="btn main-bg main-border">{% trans %}Filtrar{% endtrans %}</button>
                        <a href="{{ domain }}{% trans %}recetas{% endtrans %}" type="button" class="btn white-bg grey-border">{% trans %}Limpiar{% endtrans %}</a>
                    </div>
                {% endset %}

                <a href="#" id="show-filters" class="grey-color">{% trans %}Mostrar filtros{% endtrans %}</a>
                <div>
                    {{ buttons }}
                    <div class="filters">
                        <div class="filter">
                            <fieldset>
                                <label><h6>{% trans %}Buscar por parlabra{% endtrans %}</h6></label>
                                <input type="text" class="form-control" name="q" placeholder="{% trans %}Buscar...{% endtrans %}" value="{{ filters.query }}" />
                            </fieldset>
                        </div>
                        {% include 'recipe/checkboxes.twig' with{ type: 'checkbox', title: 'Dificultad'|trans, field: 'difficulty', checkboxes: difficulties } %}
                        {% include 'recipe/checkboxes.twig' with{ type: 'radio', title: 'Tiempo'|trans, field: 'time', checkboxes: times } %}
                        {% include 'recipe/checkboxes.twig' with{ type: 'checkbox', title: 'Etiqueta'|trans, field: 'tag', checkboxes: tags } %}
                        {% include 'recipe/checkboxes.twig' with{ type: 'checkbox', title: 'Categoría'|trans, field: 'category', checkboxes: categories } %}
                        {% include 'recipe/checkboxes.twig' with{ type: 'checkbox', title: 'Ingrediente'|trans, field: 'ingredient', checkboxes: ingredients } %}
                    </div>
                    {{ buttons }}
                </div>
            </form>
            <div class="col-lg-10">
                {% if filters.query %}
                    <div class="title">{% trans %}Resultados por{% endtrans %} <h1>"{{ filters.query|lower }}"</h1></div>
                {% endif %}
                {% if items is defined and items|length > 0 %}
                    {% include 'include/list.twig' with { recipes: items } %}
                    {% include 'include/pagination.twig' %}
                {% else %}
                    {{ 'No hemos encontrado ningún resultado. Prueba suerte con una %sreceta aleatoria%s.'|trans|format('<a href="' ~ domain ~ 'receta'|trans ~ '/' ~ 'aleatoria'|trans ~ '" class="secondary-color" rel="nofollow">', '</a>')|raw }}
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}