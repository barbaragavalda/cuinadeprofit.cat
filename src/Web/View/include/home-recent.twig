<div class="item {{ type }}">
    {% include 'include/image.twig' with { url: item.image, link: item.link, aspectRatio: '1/1' } %}
    <div class="text white-bg">
        <a href="{{ item.link }}" class="ms-madi secondary-color">{{ item.name }}</a>
        <div><small class="tertiary-color">{{ item.created }}</small></div>
    </div>
</div>