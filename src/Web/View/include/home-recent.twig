<div class="item {{ type }}">
    {% include 'include/image.twig' with { url: item.image, link: item.uri, aspectRatio: '1/1' } %}
    <div class="text white-bg">
        <span class="tertiary-color">{{ item.created }}</span>
        <a href="{{ domain }}{% trans %}receta{% endtrans %}/{{ item.uri }}"
           class="ms-madi secondary-color">{{ item.name }}</a>
    </div>
</div>