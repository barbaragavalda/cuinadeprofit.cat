<div class="col-lg-12">
    <ul id="recipes" class="hover-effect">
        {% for recipe in recipes %}
            <li class="item">
                <div class="row">
                    <div class="col-sm-4">
                        {% include 'include/image.twig' with { url: recipe.image, link: recipe.uri, aspectRatio: '1/1' } %}
                    </div>
                    <div class="col-sm-8">
                        {% if recipe.tags|length > 0 %}
                            <div>
                                {% set tags = [] %}
                                {% for tag in recipe.tags %}
                                    {% set tags = tags|merge(['<a href="' ~ domain ~ 'receptes'|trans ~ '/' ~ tag.uri ~ '" class="main-color">' ~ tag.name ~ '</a>']) %}
                                {% endfor %}
                                {{ tags|join(' | ')|raw }}
                            </div>
                        {% endif %}
                        <h2 class="ms-madi"><a
                                    href="{{ domain }}{% trans "recepta" %}/{{ recipe.uri }}">{{ recipe.name }}</a>
                        </h2>
                        <div>
                            {% include 'recipe/difficulty.twig' %}
                            <small>
                                {{ recipe.time }}
                                {% if recipe.rest_time %}
                                    (+ {{ recipe.rest_time }} {% trans "repòs" %})
                                {% endif %}
                            </small>
                        </div>
                        {% if recipe.description %}
                            {{ recipe.description|raw }}
                        {% endif %}
                    </div>
                </div>
            </li>
        {% endfor %}
    </ul>
</div>