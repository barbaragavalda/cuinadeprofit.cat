{% if not hideFilters %}
    {% include 'include/list-filters.twig' %}
{% endif %}
<div class="col-lg-10">
    {% if filters.query %}
        <div class="title">{% trans "Resultats per" %} <h1>"{{ filters.query|lower }}"</h1>
        </div>
    {% endif %}
    {% if items is defined and items|length > 0 %}
        <div class="col-lg-12">
            <ul id="recipes" class="hover-effect">
                {% for item in items %}
                    <li class="item">
                        <div class="row">
                            <div class="col-sm-4">
                                {% include 'include/image.twig' with { url: item.image, link: item.link, isOutside: item.isOutside, aspectRatio: aspectRatio } %}
                            </div>
                            {% include type ~ '/list-item.twig' %}
                        </div>
                    </li>
                {% endfor %}
            </ul>
        </div>
        {% include 'include/pagination.twig' %}
    {% else %}
        {% if noResultsLink %}
            {{ noResults|trans|format('<a href="' ~ domain ~ noResultsLink ~ '" class="secondary-color" rel="nofollow">', '</a>')|raw }}
        {% endif %}
    {% endif %}
</div>