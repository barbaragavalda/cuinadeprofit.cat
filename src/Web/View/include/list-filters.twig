<form method="POST" class="col">
    {% set buttons %}
        <div class="btn-group-sm">
            <button type="submit" name="filter"
                    class="btn main-bg main-border">{% trans "Filtrar" %}</button>
            <a href="{{ domain }}{{ link }}" type="button"
               class="btn white-bg grey-border">{% trans "Eliminar" %}</a>
        </div>
    {% endset %}

    <a href="#" id="show-filters" class="grey-color">{% trans "Mostrar filtres" %}</a>
    <div>
        {{ buttons }}
        <div class="filters">
            <div class="filter">
                <fieldset>
                    <label><h6>{% trans "Buscar per paraula" %}</h6></label>
                    <input type="text" class="form-control" name="q"
                           placeholder="{% trans "Buscar..." %}" value="{{ filters.query }}"/>
                </fieldset>
            </div>
            {% include 'recipes/checkboxes.twig' with{ type: 'checkbox', title: 'Dificultat'|trans, field: 'difficulty', checkboxes: difficulties } %}
            {% include 'recipes/checkboxes.twig' with{ type: 'radio', title: 'Temps'|trans, field: 'time', checkboxes: times } %}
            {% include 'recipes/checkboxes.twig' with{ type: 'checkbox', title: 'Etiqueta'|trans, field: 'tag', checkboxes: tags } %}
            {% include 'recipes/checkboxes.twig' with{ type: 'checkbox', title: 'Categoria'|trans, field: 'ingredient_category', checkboxes: categories } %}
            {% include 'recipes/checkboxes.twig' with{ type: 'checkbox', title: 'Ingredient'|trans, field: 'ingredient', checkboxes: ingredients } %}
        </div>
        {{ buttons }}
    </div>
</form>