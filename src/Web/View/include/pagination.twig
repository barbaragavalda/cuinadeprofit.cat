{% if pagination %}
    <div class="text-center">
        <nav class="btn-group">
            {% if pagination.current > 1 %}
                <a href="{{ domain }}{{ link }}/{{ pagination.current - 1 }}{{ extraLink }}"
                   class="btn main-color grey-border">
                    <span aria-hidden="true">&laquo;</span>
                    <span class="sr-only">{% trans %}Anterior{% endtrans %}</span>
                </a>
            {% endif %}

            {% for page in pagination.pages %}
                {% if page matches '/^\\d+$/' %}
                    {% set classBtn = 'main-color grey-border' %}
                    {% if pagination.current == page %}
                        {% set classBtn = ' main-bg white-color' %}
                    {% endif %}
                    <a href="{{ domain }}{{ link }}/{{ page }}{{ extraLink }}"
                       class="btn {{ classBtn }}">{{ '%02d'|format(page) }}</a>
                {% else %}
                    ...
                {% endif %}
            {% endfor %}

            {% set lastPage = pagination.pages[ pagination.pages|length - 1 ] %}
            {% if pagination.current < lastPage %}
                <a href="{{ domain }}{{ link }}/{{ pagination.current + 1 }}{{ extraLink }}"
                   class="btn main-color grey-border">
                    <span aria-hidden="true">&raquo;</span>
                    <span class="sr-only">{% trans %}Siguente{% endtrans %}</span>
                </a>
            {% endif %}
        </nav>
    </div>
{% endif %}