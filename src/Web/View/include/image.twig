{% if link is defined %}
{% set target = '' %}
{% if isOutside %}
    {% set target = ' target="_blank"' %}
{% endif %}
<a href="{{ link }}" {{ target|raw }}>
    {% endif %}
    {% set image = staticDomain ~ 'img/dummy.jpg' %}
    {% if url %}
        {% set image = url %}
    {% endif %}
    <div class="img" style="aspect-ratio: {{ aspectRatio }}">
        <img data-src="{{ image }}" class="lazyload img-cover" src=""/>
    </div>
    {% if link is defined %}
</a>
{% endif %}