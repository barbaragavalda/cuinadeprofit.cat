{% extends 'basic.twig' %}

{% block extraBody %}
    <script src="{{ staticDomain }}js/plugin/mixitup.min.js"></script>
    <script>
        $(document).ready(function () {
            if ($('#filter-items').length > 0) {
                var containerEl = document.querySelector('#filter-items'),
                    categories = $('.categories ul li');
                mixitup(containerEl, {
                    load: {
                        filter: $(categories[0]).attr('data-filter')
                    }
                });

                categories.on('click', function () {
                    categories.removeClass('active');
                    $(this).addClass('active');
                });
            }
        });
    </script>
{% endblock %}

{% block startLogo %}<h1>{% endblock %}
{% block endLogo %}</h1>{% endblock %}

{% block content %}
    {% if recent|length > 0 %}
        <section>
            <div class="title-left">
                <h2 class="main-bg">{% trans "Últimes receptes" %}</h2>
            </div>
            <div class="wrapper container-fluid">
                <div class="mosaic hover-effect row">
                    <div class="col-lg-6 order-lg-2">
                        {% include 'include/home-recent.twig' with{ item: recent[0], type: 'large-item' } %}
                    </div>
                    <div class="col-lg-3 col-md-6 order-lg-1">
                        {% if recent|length > 1 %}
                            {% include 'include/home-recent.twig' with{ item: recent[1] } %}
                        {% endif %}
                        {% if recent|length > 3 %}
                            {% include 'include/home-recent.twig' with{ item: recent[3] } %}
                        {% endif %}
                    </div>
                    <div class="col-lg-3 col-md-6 order-lg-3">
                        {% if recent|length > 2 %}
                            {% include 'include/home-recent.twig' with{ item: recent[2] } %}
                        {% endif %}
                        {% if recent|length > 4 %}
                            {% include 'include/home-recent.twig' with{ item: recent[4] } %}
                        {% endif %}
                    </div>
                </div>
            </div>
        </section>
    {% endif %}

    {% if potatoes|length > 0 %}
        <section>
            <div class="title">
                <h2 class=" main-bg">{% trans "Top Braves" %}</h2>
            </div>

            <div class="wrapper container-fluid">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="categories">
                            <ul>
                                {% for category in potatoes %}
                                    {% set isActive = ' class="active"' %}
                                    {% if loop.index != 1 %}
                                        {% set isActive = '' %}
                                    {% endif %}
                                    <li data-filter=".year-{{ category.uri }}"{{ isActive|raw }}>{{ category.name }}</li>
                                {% endfor %}
                            </ul>
                        </div>
                    </div>
                </div>
                <div id="filter-items" class="hover-effect">
                    {% for category in potatoes %}
                        {% for item in category.items %}
                            <div class="item mix year-{{ category.uri }}">
                                {% set link = domain ~ 'braves'|trans ~ '/?q=' ~ item.name|url_encode %}
                                {% include 'include/image.twig' with { url: item.reviews[0].image, link: link, alt: item.name, aspectRatio: '4/3' } %}
                                <a href="{{ link }}" class="secondary-font text secondary-color">{{ item.name }}</a>
                            </div>
                        {% endfor %}
                    {% endfor %}
                </div>
            </div>
        </section>
    {% endif %}

    {% if succeed|length > 0 %}
        <section>
            <div class="title-right">
                <h2 class="main-bg">{% trans "Receptes per triomfar" %}</h2>
            </div>
            <div class="wrapper container-fluid">
                {% include 'include/list.twig' with { hideFilters: true, menu: 'recipes', aspectRatio: '1/1', items: succeed } %}
            </div>
        </section>
    {% endif %}
{% endblock %}