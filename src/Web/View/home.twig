{% extends 'basic.twig' %}

{% block extraBody %}
    <script src="{{ staticDomain }}js/plugin/mixitup.min.js"></script>
    <script>
        $(document).ready(function () {
            if ($('#filter-items').length > 0) {
                var containerEl = document.querySelector('#filter-items'),
                    categories = $('.categories ul li');
                mixitup(containerEl, {
                    load: {
                        filter: $(categories[0]).attr('data-filter')
                    }
                });

                categories.on('click', function () {
                    categories.removeClass('active');
                    $(this).addClass('active');
                });
            }
        });
    </script>
{% endblock %}

{% block content %}
    {% if recent|length > 0 %}
        <section>
            <div class="title-left">
                <h5 class="main-bg">{% trans "Últimes receptes" %}</h5>
            </div>
            <div class="wrapper container-fluid">
                <div class="mosaic hover-effect row">
                    <div class="col-lg-6 order-lg-2">
                        {% include 'include/home-recent.twig' with{ item: recent[0], type: 'large-item' } %}
                    </div>
                    <div class="col-lg-3 col-md-6 order-lg-1">
                        {% if recent|length > 1 %}
                            {% include 'include/home-recent.twig' with{ item: recent[1] } %}
                        {% endif %}
                        {% if recent|length > 3 %}
                            {% include 'include/home-recent.twig' with{ item: recent[3] } %}
                        {% endif %}
                    </div>
                    <div class="col-lg-3 col-md-6 order-lg-3">
                        {% if recent|length > 2 %}
                            {% include 'include/home-recent.twig' with{ item: recent[2] } %}
                        {% endif %}
                        {% if recent|length > 4 %}
                            {% include 'include/home-recent.twig' with{ item: recent[4] } %}
                        {% endif %}
                    </div>
                </div>
            </div>
        </section>
    {% endif %}

    {% if categories|length > 0 %}
        <section>
            <div class="title">
                <h5 class=" main-bg">{% trans "Per categories" %}</h5>
            </div>

            <div class="wrapper container-fluid">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="categories">
                            <ul>
                                {% for category in categories %}
                                    {% set isActive = ' class="active"' %}
                                    {% if loop.index != 1 %}
                                        {% set isActive = '' %}
                                    {% endif %}
                                    <li data-filter=".{{ category.uri }}"{{ isActive|raw }}>{{ category.name }}</li>
                                {% endfor %}
                            </ul>
                        </div>
                    </div>
                </div>
                <div id="filter-items" class="hover-effect">
                    {% for category in categories %}
                        {% for recipe in category.recipes %}
                            {% set classItem = '' %}
                            {% for tag in recipe.tags %}
                                {% set classItem = classItem ~ ' ' ~ tag.uri %}
                            {% endfor %}
                            <div class="item mix{{ classItem }}">
                                {% include 'include/image.twig' with { url: recipe.image, link: domain ~ 'recepta'|trans ~ '/' ~ recipe.uri, aspectRatio: '4/3' } %}
                                <a href="{{ domain }}{% trans "recepta" %}/{{ recipe.uri }}"
                                   class="ms-madi text secondary-color">{{ recipe.name }}</a>
                            </div>
                        {% endfor %}
                    {% endfor %}
                </div>
            </div>
        </section>
    {% endif %}

    {% if succeed|length > 0 %}
        <section>
            <div class="title-right">
                <h5 class="main-bg">{% trans "Receptes per triomfar" %}</h5>
            </div>
            <div class="wrapper container-fluid">
                {% include 'include/list.twig' with { hideFilters: true, type: 'recipe', aspectRatio: '1/1', items: succeed } %}
            </div>
        </section>
    {% endif %}
{% endblock %}