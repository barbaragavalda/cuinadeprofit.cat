        <h3>{{ 'Sembla que ens hem perdut. Per recuperar el rumb: et proposem que provis sort amb una %srecepta aleatòria%s.'|trans|format('<a href="' ~ domain ~ 'recepta'|trans ~ '/' ~ 'aleatoria'|trans ~ '" class="secondary-color" rel="nofollow">', '</a>')|raw }}</h3>
